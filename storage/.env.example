# Storage System Configuration
#
# This file contains S3 credentials and storage configuration for the
# Scenario Reasoner LM on RunPod.
#
# IMPORTANT: Add this file to .gitignore (never commit credentials!)
#
# Usage:
#   source .env
#   bash storage/orchestrate_storage.sh pipeline
#

# ============================================================================
# S3 CLOUD STORAGE CONFIGURATION (Required for Download/Upload)
# ============================================================================

# S3-compatible cloud provider endpoint
# Examples:
#   AWS:           https://s3.amazonaws.com
#   DigitalOcean:  https://nyc3.digitaloceanspaces.com
#   MinIO:         https://minio.example.com:9000
#   Backblaze B2:  https://s3.us-west-000.backblazeb2.com
export S3_ENDPOINT_URL="https://s3.amazonaws.com"

# AWS/S3 access credentials
# SECURITY: Never commit these to version control!
export S3_ACCESS_KEY_ID="AKIA..."
export S3_SECRET_ACCESS_KEY="your_secret_key_here"

# S3 bucket name
export S3_BUCKET="training-results-prod"

# ============================================================================
# S3 PATH CONFIGURATION (Optional)
# ============================================================================

# Path in bucket where data is downloaded FROM
# Example: bucket/datasets/scenario-v1/
export S3_DOWNLOAD_PREFIX="datasets/scenario-v1"

# Path in bucket where results are uploaded TO
# Example: bucket/scenario-reasoner-lm/runs/...
export S3_UPLOAD_PREFIX="scenario-reasoner-lm"

# ============================================================================
# STORAGE PATHS (Optional - defaults to current directory)
# ============================================================================

# Project root directory
# export PROJECT_ROOT="/path/to/scenario-reasoner-lm"

# Workspace mount (RunPod network volume)
# export WORKSPACE_MOUNT="/workspace"

# ============================================================================
# DAEMON CONFIGURATION (Optional)
# ============================================================================

# Interval between upload passes (in seconds)
# Default: 600 (10 minutes)
# Adjust based on training duration and file change frequency
export UPLOAD_INTERVAL="600"

# ============================================================================
# UPLOAD BEHAVIOR (Optional)
# ============================================================================

# Enable gzip compression for text files (.json, .log, .yaml, .csv)
# 1 = enabled (default, 80-95% reduction), 0 = disabled
export COMPRESS_TEXT="1"

# Verbose output during operations
# 1 = enabled (default), 0 = disabled
export VERBOSE="1"

# Dry run mode - preview uploads without actually uploading
# 1 = dry run (show what would be uploaded), 0 = actually upload (default)
export DRY_RUN="0"

# ============================================================================
# DOCKER COMPOSE (For RunPod pod setup)
# ============================================================================

# Network volume mount path on RunPod
# This is mounted to /app/data inside the container
export WORKSPACE_MOUNT="/workspace"

# ============================================================================
# NOTES
# ============================================================================

# Storage Strategy for RunPod:
#   Container (/app):  40GB  → Code, dependencies, configs
#   Network Volume:    95GB  → Data, experiments, artifacts, logs
#
# Typical allocation for one training run:
#   data/         ~20GB  (datasets downloaded from S3)
#   experiments/  ~50GB  (models, metrics, checkpoints)
#   artifacts/    ~10GB  (demo exports)
#   buffer/       ~15GB  (safety margin)
#
# Quick commands:
#   source .env
#   bash storage/orchestrate_storage.sh pipeline          # Full setup
#   bash storage/s3_upload_daemon.sh logs                 # Monitor uploads
#   bash storage/orchestrate_storage.sh status            # Check storage
#
# Test your configuration:
#   source .env
#   bash storage/s3_download.sh                           # Test download
#   bash storage/s3_upload.sh                             # Test upload (dry-run by default)
